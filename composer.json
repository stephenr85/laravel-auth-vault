{
    "name": "rushing/laravel-auth-vault",
    "description": "A generic per-tenant credential vault for Laravel — encrypted, append-only secret storage with safe rotation and an OAuth token-refresh primitive. Stores API keys and OAuth tokens; knows nothing of connectors, tenancy, or billing.",
    "keywords": ["laravel", "credentials", "vault", "oauth", "secrets", "encryption", "rotation"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "spatie/laravel-data": "^4.0|^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\AuthVault\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\AuthVault\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rushing\\AuthVault\\AuthVaultServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
